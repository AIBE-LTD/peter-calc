{
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/prime-rate.js": {
      "memory": 256,
      "maxDuration": 15
    },
    "api/report.py": {
      "maxDuration": 30,
      "excludeFiles": "{node_modules/**,docs/**,work/**,__pycache__/**,.env,.env.*,*.env,*.env.*,.vercel_python_packages/**}",
      "includeFiles": "{report.py,public/*.png,dist/*.png}"
    }
  }
}
